[sub_resource type="GDScript" id="GDScript_uu2ix"]
script/source = "extends Node2D


func _on_game_manager_on_pause() -> void:
	get_tree().paused = true
	print(\"paused\")
	

func _on_game_manager_on_resume() -> void:
	get_tree().paused = false
	print(\"unpause\")
"

